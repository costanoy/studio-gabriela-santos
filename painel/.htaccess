# Painel da dona do studio. Nada aqui deve aparecer no Google nem ficar guardado no aparelho.
DirectoryIndex index.php
Options -Indexes

<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow"
Header always set Cache-Control "no-store"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "same-origin"
</IfModule>

# So paginas e arquivos do painel; nunca dados, logs ou anotacoes
<FilesMatch "\.(json|log|md|lock|tmp|bak|sql|ini|txt)$">
Require all denied
</FilesMatch>
